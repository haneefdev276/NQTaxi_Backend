# =============================================================================
# NQTaxi Backend — environment variables
# Copy this file to `.env` and fill in your local values:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
# =============================================================================

# --- Django core ---
# Generate a new secret key for each environment (never commit the real value).
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-50-character-random-secret-key

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Default values match `docker-compose.yml` in this folder.
DB_NAME=conzura_data
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- JWT (SimpleJWT) ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Razorpay (wallet top-up) ---
# Required for wallet APIs. Use Razorpay TEST keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Auto-complete top-up in dev without Razorpay checkout UI (True/False)
RAZORPAY_AUTO_COMPLETE_TOPUP=False

# --- CORS (frontend origins allowed to call this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
